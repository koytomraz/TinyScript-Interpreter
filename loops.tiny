// loops.tiny — while loops
// Run: node index.js examples/loops.tiny

// Count from 1 to 5
print("Counting 1 to 5:")
let i = 1
while (i <= 5) {
  print(i)
  i = i + 1
}

// Sum 1..100 (Gauss problem)
print("Sum of 1 to 100:")
let sum = 0
let n   = 1
while (n <= 100) {
  sum = sum + n
  n   = n + 1
}
print(sum)             // 5050

// Multiplication table for 3
print("Multiplication table for 3:")
let k = 1
while (k <= 10) {
  print(3 * k)
  k = k + 1
}

// Countdown
print("Countdown:")
let c = 5
while (c >= 0) {
  print(c)
  c = c - 1
}
print("Blast off!")
